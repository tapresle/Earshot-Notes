{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Earshot Notes",
  "version": "0.1.5",
  "identifier": "com.tedpresley.earshot",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Earshot Notes",
        "width": 1200,
        "height": 780,
        "minWidth": 900,
        "minHeight": 560,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/models/whistle.cact": "models/whistle.cact",
      "../LICENSE": "licenses/Earshot-Notes-LICENSE.txt",
      "resources/licenses/needle-LICENSE.txt": "licenses/needle-LICENSE.txt",
      "resources/licenses/whistle-LICENSE.txt": "licenses/whistle-LICENSE.txt",
      "resources/licenses/llama.cpp-LICENSE.txt": "licenses/llama.cpp-LICENSE.txt",
      "resources/licenses/third-party-notices.txt": "licenses/third-party-notices.txt"
    },
    "macOS": {
      "minimumSystemVersion": "26.0",
      "signingIdentity": "-",
      "hardenedRuntime": true,
      "entitlements": "./Entitlements.plist"
    },
    "category": "Productivity",
    "shortDescription": "Meeting notes with on-device transcription and summaries"
  }
}
